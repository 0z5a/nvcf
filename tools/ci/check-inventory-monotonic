"""Fail when a target release inventory moves an artifact backward from a baseline."""
import argparse
import json
import re
import sys


def key(version):
    # Split into numeric and text runs so 2.6.3-nv-1.3.9 > 2.6.3-nv-1.3.7,
    # 1.10.0 > 1.9.0, and v1.20.5 compares equal to 1.20.5.
    parts = re.findall(r"\d+|[A-Za-z]+", version.lstrip("v"))
    return [(0, int(p)) if p.isdigit() else (1, p) for p in parts]


def load(path):
    best = {}
    with open(path) as f:
        artifacts = json.load(f).get("artifacts", [])
    for a in artifacts:
        if a.get("type") not in ("container-image", "chart", "helm-chart"):
            continue
        name, version = a["name"], a["version"]
        if name not in best or key(version) > key(best[name]):
            best[name] = version
    return best


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--baseline", required=True)
    ap.add_argument("--target", required=True)
    ap.add_argument("--allow", action="append", default=[], help="name=reason")
    args = ap.parse_args()
    allowed = {x.split("=", 1)[0] for x in args.allow}
    base, target = load(args.baseline), load(args.target)
    bad = [(n, base[n], target[n]) for n in sorted(base) if n in target and n not in allowed and key(target[n]) < key(base[n])]
    for name, old, new in bad:
        print(f"BACKWARD {name} {old} -> {new}")
    return 1 if bad else 0


sys.exit(main())
