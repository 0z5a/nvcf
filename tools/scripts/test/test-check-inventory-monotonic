import json
import os
import subprocess
import sys
import tempfile
import unittest

TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "ci", "check-inventory-monotonic")


def run(baseline, target, *extra):
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for name, arts in (("a", baseline), ("b", target)):
            p = os.path.join(d, name + ".json")
            with open(p, "w") as f:
                json.dump({"artifacts": [{"type": "container-image", "name": k, "version": v} for k, v in arts]}, f)
            paths.append(p)
        return subprocess.run([sys.executable, TOOL, "--baseline", paths[0], "--target", paths[1], *extra], capture_output=True, text=True)


class Monotonic(unittest.TestCase):
    def test_forward_ok(self):
        self.assertEqual(run([("nats-server", "2.14.6-alpine3.22")], [("nats-server", "2.14.9-alpine3.22")]).returncode, 0)

    def test_backward_fails_and_names_artifact(self):
        r = run([("nats-server", "2.14.9-alpine3.22")], [("nats-server", "2.14.6-alpine3.22")])
        self.assertEqual(r.returncode, 1)
        self.assertIn("nats-server", r.stdout)

    def test_openbao_suffix_build_ordering(self):
        r = run([("nvcf-openbao", "2.6.3-nv-1.3.9")], [("nvcf-openbao", "2.6.3-nv-1.3.7")])
        self.assertEqual(r.returncode, 1)

    def test_v_prefix_and_new_artifacts_ok(self):
        r = run([("cert-manager-controller", "v1.20.5")], [("cert-manager-controller", "v1.20.5"), ("new-image", "1.0.0")])
        self.assertEqual(r.returncode, 0)

    def test_allow_list_suppresses(self):
        r = run([("k8s", "1.37.0")], [("k8s", "1.33.1")], "--allow", "k8s=reviewed")
        self.assertEqual(r.returncode, 0)

    def test_multiple_versions_use_highest_in_each_side(self):
        r = run([("k8s", "1.37.0"), ("k8s", "1.33.1")], [("k8s", "1.37.0")])
        self.assertEqual(r.returncode, 0)

    def test_numeric_not_lexicographic(self):
        r = run([("x", "1.9.0")], [("x", "1.10.0")])
        self.assertEqual(r.returncode, 0)


if __name__ == "__main__":
    unittest.main()
